# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API Keys.
# Both values are public by design; data is protected by Row Level Security.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" (legacy) or "publishable" key. NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
